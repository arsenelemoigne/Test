# Login
DEMO_PASSWORD=

# Database and screenshots (Supabase project registre-pi)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI (OpenRouter, OpenAI-compatible)
OPENROUTER_API_KEY=
# Strong model: legal answers, infringement planning, scoring and visual comparison
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Fast model: triage, extraction, web searches
OPENROUTER_MODEL_FAST=google/gemini-2.5-flash
# Thinking budget shown in the déroulé (0 turns it off)
OPENROUTER_REASONING_TOKENS=1024

# Sources
INPI_USERNAME=
INPI_PASSWORD=
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
PISTE_API_KEY=
SEARCHAPI_API_KEY=
URLSCAN_API_KEY=
# Optional: reverse image search from the product photo (Cloud Vision, web detection)
GOOGLE_VISION_API_KEY=

# Email assistant (Resend)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM=Registre PI <assistant@getmanda.eu>
ASSISTANT_EMAIL=
LAWYER_EMAIL=
ALLOWED_SENDERS=
APP_URL=https://pi.getmanda.eu
